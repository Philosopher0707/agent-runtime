.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.ruff_cache/
dist/
build/
*.egg-info/

# Run traces are a runtime artefact, not source. Keep the directory, drop the contents.
.traces/*
!.traces/.gitkeep

# Notes written by the write_note tool in the worked examples.
.notes/

# The triage domain's escalation log. The messages beside it are fixtures and are tracked;
# the log is what a run produced, so it is an artefact like a trace.
messages/escalations.jsonl

.env
.env.local

# Agent working memory: workspace-local scratch, not project source. It stays on disk but
# out of the repository, so publishing the repository does not publish the notes.
.workbuddy-ai/
