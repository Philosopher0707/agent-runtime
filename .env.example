# Copy to .env and fill in:  cp .env.example .env
#
# Every entry point — the CLI, the service, and the scripts — loads this file before doing
# anything else, so copying it is all that is needed. It was not always so: this file
# existed, .gitignore listed .env, and nothing read it, so a key placed here was silently
# ignored and the provider was called unauthenticated.
#
# A real environment variable always wins over this file, which makes a one-off override
# easy:  AGENT_API_KEY=... make ci
#
# .env is gitignored. Secrets never appear in a prompt, a log line, or a trace.

# Provider selection. One of: stub, openai_compat
AGENT_PROVIDER=stub

# --- openai_compat only -------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint.
AGENT_BASE_URL=https://api.example.com/v1
AGENT_API_KEY=
AGENT_MODEL=mid-tier-model-name

# USD per 1M tokens, used for cost accounting against max_cost_usd.
AGENT_PRICE_INPUT_PER_MTOK=0.0
AGENT_PRICE_OUTPUT_PER_MTOK=0.0

# --- runtime ------------------------------------------------------------------
AGENT_TRACE_DIR=.traces
AGENT_CONFIG=configs/default.yaml
# make eval fails below this fraction of passing cases.
EVAL_THRESHOLD=1.0

# --- service ------------------------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=8080

# --- rollback -----------------------------------------------------------------
# Optional. `make rollback` opens the pull request itself when this is set; otherwise it
# pushes the branch and prints the compare URL.
# GH_TOKEN=
