# Copy to .env and fill in:  cp .env.example .env
#
# Every entry point — the CLI, the service, and the scripts — loads this file before doing
# anything else. A real environment variable always wins over it, so a one-off override is
# easy:  AGENT_API_KEY=... make ci
#
# .env is gitignored. Secrets never appear in a prompt, a log line, or a trace.
#
# ONLY VARIABLES THAT ARE ACTUALLY READ BELONG IN THIS FILE. It used to list six that
# nothing read — AGENT_BASE_URL, AGENT_MODEL, AGENT_PRICE_*, AGENT_PROVIDER and
# AGENT_TRACE_DIR — so setting them did nothing at all, silently. A test now fails if this
# file advertises a name the code never reads.

# --- the model -----------------------------------------------------------------
# The endpoint, the model name and the prices are declared in the configuration file, not
# here: a capability is a config file, and those are part of the capability. Point
# configs/openai_compat.yaml at your endpoint, then name it with AGENT_CONFIG below.
AGENT_API_KEY=
AGENT_CONFIG=configs/openai_compat.yaml

# --- service ------------------------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=8080

# --- evaluation ---------------------------------------------------------------
# make eval fails below this fraction of passing cases.
EVAL_THRESHOLD=1.0

# --- rollback -----------------------------------------------------------------
# Optional. `make rollback` opens the pull request itself when this is set; otherwise it
# pushes the branch and prints the compare URL.
# GH_TOKEN=
